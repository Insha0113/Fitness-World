# ─── Database (PostgreSQL) ─────────────────────────────────────────
# Local Docker:  postgresql://fitness:<password>@localhost:5433/fitness_world
# Neon/Supabase: use the pooled connection string they give you (sslmode=require)
DATABASE_URL="postgresql://user:password@localhost:5432/fitness_world"

# ─── Auth (NextAuth) ───────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# First admin account, created/updated by `npx prisma db seed` (password ≥ 12 chars)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── Razorpay (server-side only — never prefix the secret with NEXT_PUBLIC_) ──
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks → secret you set there
RAZORPAY_WEBHOOK_SECRET=""

# ─── FITBOT (Claude API) ───────────────────────────────────────────
# Without it, FITBOT shows an "offline" panel with callback/WhatsApp links.
ANTHROPIC_API_KEY=""

# ─── Email (Resend) ────────────────────────────────────────────────
# Without it, emails are printed to the server console in development.
RESEND_API_KEY=""
EMAIL_FROM="Fitness World <hello@your-verified-domain.com>"
# Comma-separated addresses that receive new-lead and payment alerts
ADMIN_NOTIFY_EMAIL=""

# ─── Public business details (shown on the site) ───────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Digits only, with country code, e.g. 919800000000
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
